# Fleet Commander Environment Variables
# Copy this file to .env and customize for your project

# ============================================
# Fleet Commander Configuration
# ============================================

# Number of Claude Code instances to run in parallel (default: 5)
FLEET_SIZE=5

# Preferred Claude model for planning tasks
FLEET_PLANNING_MODEL=opus-4.5

# Preferred Claude model for execution tasks
FLEET_EXECUTION_MODEL=sonnet-4.5

# Enable system notifications (true/false)
FLEET_NOTIFICATIONS_ENABLED=true

# ============================================
# Project-Specific Configuration
# ============================================

# Your project name
PROJECT_NAME=my-project

# Development environment
NODE_ENV=development

# API endpoints (if applicable)
# API_URL=http://localhost:3000
# API_KEY=your-api-key-here

# Database connection (if applicable)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ============================================
# Hook Configuration
# ============================================

# Enable post-tool-use auto-formatting (true/false)
HOOKS_AUTO_FORMAT=true

# Enable pre-commit verification (true/false)
HOOKS_PRE_COMMIT=true

# Fail commit on test failures (true/false)
HOOKS_FAIL_ON_ERROR=true

# ============================================
# CI/CD Configuration (Optional)
# ============================================

# GitHub token for PR creation (if using gh CLI)
# GITHUB_TOKEN=your-github-token

# Slack webhook for notifications (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord webhook for notifications (optional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# ============================================
# Language-Specific Configuration
# ============================================

# Python
# PYTHONPATH=./src

# Node.js
# NPM_CONFIG_REGISTRY=https://registry.npmjs.org/

# Rust
# RUST_BACKTRACE=1

# ============================================
# Testing Configuration
# ============================================

# Test framework timeout (milliseconds)
# TEST_TIMEOUT=30000

# Parallel test execution (true/false)
# RUN_TESTS_PARALLEL=true

# Coverage threshold (percentage)
# COVERAGE_THRESHOLD=80

# ============================================
# Notes
# ============================================

# 1. Never commit this file with actual secrets to git
# 2. Add .env to .gitignore (already done)
# 3. Use environment-specific files: .env.local, .env.production
# 4. For team sharing, document all required variables in README.md
